# Sousa Group One - local Proxmox deployment
# Copy this file to deploy/local/.env and NEVER commit the real .env.

POSTGRES_DB=sousa_group_one
POSTGRES_USER=sgo
# Use a URL-safe value. Example generation: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

APP_BIND=0.0.0.0
APP_PORT=3000

# Application secrets.
# A new JWT secret invalidates existing sessions but does not delete users/data.
# Example generation: openssl rand -hex 48
JWT_SECRET=CHANGE_ME

# IMPORTANT: if 2FA/TOTP is already enabled in production, copy the EXISTING
# TOTP_ENCRYPTION_KEY from Render. Changing it can make existing TOTP secrets unreadable.
# New-key generation (only if no existing encrypted TOTP data): openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Start with false for a temporary HTTP LAN test.
# Set true before using the application through a public HTTPS tunnel/domain.
COOKIE_SECURE=false

# Public HTTPS domain used by Passkeys/WebAuthn.
# Example:
# WEBAUTHN_RP_ID=app.sousagroup.ch
# WEBAUTHN_ORIGIN=https://app.sousagroup.ch
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=Sousa Group One

# Existing admin bootstrap values are normally unnecessary after restoring the Render DB.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Keep false until entity_records has been deliberately made canonical in production.
STATE_ENTITY_CANONICAL=false

# Optional AI / OCR configuration. Copy current production values if used.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=none
AI_TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
AI_TRANSCRIBE_MODEL=gpt-transcribe
AI_TRANSCRIBE_LANGUAGE=fr

# Optional TURN configuration for reliable audio/video calls.
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# Optional S3-compatible storage (R2/S3/MinIO).
# If left blank, uploaded files remain in PostgreSQL and manual backups are written
# to deploy/local/backups through the mounted /app/backups directory.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PREFIX=sgo
BACKUP_OBJECT_PREFIX=backups

# Optional Cloudflare Tunnel. Only needed when running compose with --profile tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
