DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sousa_group_one
# For a local PostgreSQL instance only. Keep TLS verification enabled on hosted databases.
PGSSL=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 32-byte random key encoded as base64. Required in production to encrypt TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=
# Keep true on HTTPS production. Set false only for explicit local HTTP development.
COOKIE_SECURE=true
# Passkeys / WebAuthn. Set these to the canonical HTTPS production domain.
# Example for the current Render domain:
# WEBAUTHN_RP_ID=sousa-group-one.onrender.com
# WEBAUTHN_ORIGIN=https://sousa-group-one.onrender.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=Sousa Group One
# Required for initial setup / replacement of the old public demo administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PORT=3000

# P3 Intelligence / OCR.
# Recommended OpenAI production configuration for text + vision/OCR.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
# OPENAI_API_KEY is also accepted as an alternative to AI_API_KEY.
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
# GPT-6 Sol/Luna support "none"; higher reasoning removes temperature automatically.
AI_REASONING_EFFORT=none
# Server-side audio transcription. Browser dictation remains available too.
AI_TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
AI_TRANSCRIBE_MODEL=gpt-transcribe
AI_TRANSCRIBE_LANGUAGE=fr


# P2 external connectors. The P2 core remains usable without these.
# Calendar providers can be connected through server-side HTTP adapters.
GOOGLE_CALENDAR_API_URL=
GOOGLE_CALENDAR_API_KEY=
MICROSOFT_CALENDAR_API_URL=
MICROSOFT_CALENDAR_API_KEY=
# Generic server-side HTTP delivery adapters for email and SMS.
EMAIL_API_URL=
EMAIL_API_KEY=
SMS_API_URL=
SMS_API_KEY=


# Production hardening / readiness.
# Set true only after moving Render PostgreSQL to a persistent paid database.
DB_PERSISTENCE_CONFIRMED=false
# After the canonical-state migration tests pass, this removes the large mirrored
# business collections from app_state and loads them from entity_records.
STATE_ENTITY_CANONICAL=false

# WebRTC TURN relay. Required for reliable audio/video across strict NAT/4G/5G.
# Example: turn:turn.example.com:3478,turns:turn.example.com:5349
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# S3-compatible object storage (Cloudflare R2, AWS S3, MinIO, etc.).
# Endpoint example for R2: https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PREFIX=sgo
BACKUP_OBJECT_PREFIX=backups
