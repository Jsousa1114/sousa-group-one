DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sousa_group_one
# For a local PostgreSQL instance only. Keep TLS verification enabled on hosted databases.
PGSSL=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 32-byte random key encoded as base64. Required in production to encrypt TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=
# Keep true on HTTPS production. Set false only for explicit local HTTP development.
COOKIE_SECURE=true
# Required for initial setup / replacement of the old public demo administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PORT=3000

# Infrastructure P0
# 32-byte random key encoded as base64. Keep this outside the database itself.
BACKUP_ENCRYPTION_KEY=
DATABASE_PERSISTENT=false
DATABASE_EXPIRES_AT=

# WebRTC TURN relay
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# External object storage (future automatic file/backup storage)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Optional external monitoring
ERROR_MONITOR_DSN=
