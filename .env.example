DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sousa_group_one
# For a local PostgreSQL instance only. Keep TLS verification enabled on hosted databases.
PGSSL=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 32-byte random key encoded as base64. Required in production to encrypt TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=
# Keep true on HTTPS production. Set false only for explicit local HTTP development.
COOKIE_SECURE=true
# Passkeys / WebAuthn. Set these to the canonical HTTPS production domain.
# Example for the current Render domain:
# WEBAUTHN_RP_ID=sousa-group-one.onrender.com
# WEBAUTHN_ORIGIN=https://sousa-group-one.onrender.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=Sousa Group One
# Required for initial setup / replacement of the old public demo administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PORT=3000

# P3 Intelligence / OCR.
# AI_API_URL must accept the chat/vision request schema used by the application.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Optional server-side audio transcription. Browser dictation remains available
# on compatible browsers without this endpoint.
AI_TRANSCRIBE_API_URL=
AI_TRANSCRIBE_MODEL=whisper-1
AI_TRANSCRIBE_LANGUAGE=fr
