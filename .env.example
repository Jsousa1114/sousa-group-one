DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sousa_group_one
# For a local PostgreSQL instance only. Keep TLS verification enabled on hosted databases.
PGSSL=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Required for initial setup / replacement of the old public demo administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PORT=3000

# Optional P3 AI assistant. Leave unset to disable all external AI calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
